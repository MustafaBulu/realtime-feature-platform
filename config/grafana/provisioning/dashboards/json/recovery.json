{
  "uid": "rfp-recovery",
  "title": "RFP Recovery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Restore duration",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "rfp_worker_restore_duration_seconds{quantile=\"0.5\"}", "legendFormat": "p50"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "rfp_worker_restore_duration_seconds{quantile=\"0.95\"}", "legendFormat": "p95"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "rfp_worker_restore_duration_seconds{quantile=\"0.99\"}", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Rebalance activity",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "increase(rfp_worker_kafka_partitions_assigned_total[15m])", "legendFormat": "assigned"},
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "increase(rfp_worker_kafka_partitions_revoked_total[15m])", "legendFormat": "revoked"}
      ]
    },
    {
      "type": "stat",
      "title": "Recovery readiness",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 6},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "max(application_ready_time_seconds)", "legendFormat": "ready time"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Checkpointed throughput",
      "gridPos": {"x": 8, "y": 8, "w": 16, "h": 6},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "Prometheus"}, "expr": "rate(rfp_worker_events_received_total[5m])", "legendFormat": "records/s"}
      ]
    }
  ]
}
